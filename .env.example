# ---------------------------------------------------------------------------------
# AM Consulting LLC / AMCMS — self-hosted environment. Copy to .env (never commit it).
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n/+=' ; echo
# ---------------------------------------------------------------------------------

# --- Domain & HTTPS (Docker Compose / Caddy) ---------------------------------------
# Your domain, already pointing (DNS A record) at the server's IP. Caddy gets the certificate.
DOMAIN=amconsultingllc.net
# Email Let's Encrypt uses for certificate expiry notices.
ACME_EMAIL=info@amconsultingllc.net
# Public site origin used in emails, links, canonical URLs and the sitemap.
PUBLIC_SITE_URL=https://amconsultingllc.net
# Extra allowed Origins for POST endpoints (comma-separated), e.g. a staging domain.
ALLOWED_ORIGINS=

# --- PostgreSQL ------------------------------------------------------------------------
# Superuser password (used only by the database container itself and for backups/restores).
POSTGRES_SUPERUSER_PASSWORD=
# Password for the "amcms" application role (owns the database; NOT a superuser).
APP_DB_PASSWORD=
# Without Docker Compose, set DATABASE_URL directly instead (compose builds it for you):
# DATABASE_URL=postgresql://amcms:PASSWORD@localhost:5432/amcms
# For a managed database that requires TLS (e.g. DigitalOcean Managed PostgreSQL):
# PGSSLMODE=require
# PG_POOL_MAX=10

# --- Security (all REQUIRED, all random, 32+ characters) -------------------------------
# Signs private-document download links and encrypts MFA secrets. Changing it invalidates
# existing two-step verification enrolments (staff must re-enrol) — keep it stable and backed up.
AUTH_SECRET=
# Salt for one-way IP hashes (abuse prevention without storing raw IPs).
IP_HASH_SALT=
# Bearer secret for the internal daily maintenance job (the scheduler container sends it).
CRON_SECRET=
# MFA is required for all staff. Only set to "false" for local development.
AMCMS_REQUIRE_MFA=true

# --- Email (optional) --------------------------------------------------------------------
# Transactional email via Resend. Without a key, emails are logged as "skipped": submissions are
# still saved, and staff invite links are shown to the inviting admin instead of emailed.
RESEND_API_KEY=
LEAD_RECIPIENT_EMAIL=info@amconsultingllc.net
LEAD_FROM_EMAIL='"AM Consulting & Hauling" <notifications@amconsultingllc.net>'

# --- Bot protection (optional; both needed to enable Cloudflare Turnstile) ---------------
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Address search (optional) ----------------------------------------------------------
# Google Maps Platform browser key for address suggestions (Places API (New) + Geocoding API).
# It is visible in the browser by design: in Google Cloud, restrict it to your domain (HTTP
# referrer) and to those two APIs, and set a budget alert. Blank = free OpenStreetMap search.
VITE_GOOGLE_MAPS_API_KEY=

# --- Backups ---------------------------------------------------------------------------
# Days of nightly backups kept in ./backups (copy them off the server too).
BACKUP_KEEP_DAYS=14

# --- Local development only -----------------------------------------------------------
# STORAGE_DIR=.storage          where uploads are written (Docker uses a volume at /data/storage)
# COOKIE_SECURE=false           allow the session cookie over plain http://localhost
