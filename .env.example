# ---------------------------------------------------------------------------------
# AM Consulting LLC / AMCMS environment. Copy to .env (never commit real values).
# ---------------------------------------------------------------------------------
# Supabase (Lovable Cloud provides these). Publishable/anon values are safe in the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=YOUR-PROJECT
SUPABASE_PROJECT_ID=YOUR-PROJECT
# SERVER ONLY — bypasses RLS. Store as a deployment secret; never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Public site origin used in emails, canonical URLs and the sitemap.
PUBLIC_SITE_URL=https://amconsultingllc.net
VITE_PUBLIC_SITE_URL=https://amconsultingllc.net
# Extra allowed Origins for public POST endpoints (comma-separated), e.g. preview domains.
ALLOWED_ORIGINS=

# Transactional email (Resend). Without a key, emails are logged as "skipped" — submissions are still saved.
RESEND_API_KEY=
LEAD_RECIPIENT_EMAIL=info@amconsultingllc.net
LEAD_FROM_EMAIL="AM Consulting LLC <notifications@amconsultingllc.net>"

# Security
# Random 32+ char secret used to hash IP addresses (abuse prevention without storing raw IPs).
IP_HASH_SALT=
# MFA is required for all staff. Only set to "false" for local development.
AMCMS_REQUIRE_MFA=true
# One-time bootstrap: this verified email becomes super admin if none exists. Remove after use.
BOOTSTRAP_SUPER_ADMIN_EMAIL=
# Bearer secret for POST /api/cron/maintenance (daily scheduled job).
CRON_SECRET=

# Optional Cloudflare Turnstile bot protection (both required to enable).
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
