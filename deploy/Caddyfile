# Automatic HTTPS (Let's Encrypt) for {$DOMAIN} and www.{$DOMAIN}; HTTP redirects to HTTPS.
{
	email {$ACME_EMAIL}
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	# Uploads are capped at 105 MB by the app; keep the proxy limit just above it.
	request_body {
		max_size 110MB
	}
	# Cron endpoint is only for the internal scheduler.
	@cron path /api/cron/*
	respond @cron 404
	# Landing video/poster straight from disk: supports byte ranges (required by Safari/iOS) and caching.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=604800"
		file_server
	}
	reverse_proxy app:3000
}
